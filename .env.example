# Copy to .env and fill in your own values. Never commit the real .env.
# Only VITE_* variables are exposed to the browser bundle.

VITE_APP_NAME=TrueFit AI

# Base URL of the FastAPI backend. Required — the app throws on startup without it.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Clerk publishable key (safe to ship in the bundle; the secret key stays backend-only).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# How many matches to fetch for history + dashboard stats.
VITE_HISTORY_LIMIT=100

# How many of those to show in the dashboard's Recent Matches list.
VITE_RECENT_MATCHES_SHOWN=5
